FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret

# PostgreSQL Database (Supabase)
# Use the Session/Transaction Pooler connection string from
# Supabase Dashboard > Settings > Database > Connection Pooling.
# The direct "db.<ref>.supabase.co" host is IPv6-only and will NOT work
# on Vercel (and many other serverless hosts), only use it if your
# environment has IPv6 egress. URL-encode special characters in the
# password (e.g. "@" -> "%40").
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase (used for reference/administration only - the app talks to
# Postgres directly via DATABASE_URL, not the Supabase REST API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<anon-key>

# Gemini API key - used for generation, embeddings (RAG) and reply classification
GEMINI_API_KEY=

# Automation Email Service Configuration (optional - outreach send/reply-fetch
# features log to console and no-op if left blank)
GMAIL_USER=
GMAIL_APP_PASSWORD=
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com

# Integrations (optional - approval notifications just log to console if blank)
SLACK_WEBHOOK_URL=
GOOGLE_CALENDAR_CREDENTIALS_JSON=credentials.json

APP_BASE_URL=http://localhost:5000
